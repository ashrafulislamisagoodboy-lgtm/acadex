{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "acadex",
  "main": "./cloudflare/worker.ts",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ACADEX_DATABASE",
        "class_name": "AcadexDatabase"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AcadexDatabase"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
