{
  "name": "acadex",
  "private": true,
  "version": "1.0.0",
  "description": "A local-first learning and quiz platform.",
  "author": "Acadex",
  "main": "desktop-app/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "node server/index.ts --dev",
    "start": "node server/index.ts",
    "build": "vite build",
    "preview": "node server/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "tsc --noEmit",
    "test": "node --test tests/server.test.mjs",
    "web:build": "npm run build && node scripts/build-web.mjs",
    "web:package": "npm run web:build && powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/package-web.ps1",
    "cloudflare:dev": "npm run build && wrangler dev",
    "cloudflare:deploy": "npm run build && wrangler deploy",
    "desktop:bundle": "node scripts/build-desktop.mjs",
    "desktop:pack": "npm run build && npm run desktop:bundle && electron-builder --projectDir desktop-app --config ../desktop/electron-builder.yml --win dir",
    "desktop:build": "npm run build && npm run desktop:bundle && electron-builder --projectDir desktop-app --config ../desktop/electron-builder.yml --win"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.0",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wrangler": "^4.151.3"
  }
}
